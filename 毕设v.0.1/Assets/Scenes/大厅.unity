  _levelTitle: "\u7B2C\u4E8C\u5173\uFF1A\u6587\u5B57\u72F1"
  _levelDesc: "\u89C6\u89C9\u7684\u6781\u9650\u6311\u6218"
  _dialogueLines:
  - "\u6B22\u8FCE\u6765\u5230\u65F6\u7A7A\u8BD5\u70BC\u4E4B\u6BBF\u3002"
  - "\u4F60\u4EEC\u4E24\u4F4D\u5C06\u88AB\u9001\u5165\u540C\u4E00\u4E2A\u623F\u95F4\u2014\u2014\u8FD9\u4E00\u6B21\uFF0C\u8003\u9A8C\u7684\u662F\u4F60\u4EEC\u7684\u773C\u529B\u4E0E\u9ED8\u5951\u3002"
  - "\u300E\u773C\u89C1\u672A\u5FC5\u4E3A\u5B9E\u3002\u300F"
  - "\u623F\u95F4\u91CC\u7684\u4E00\u5207\u90FD\u53EF\u80FD\u6B3A\u9A97\u4F60\u4EEC\u2014\u2014\u591A\u89C2\u5BDF\uFF0C\u591A\u4EA4\u6D41\uFF0C\u522B\u6025\u7740\u4E0B\u7ED3\u8BBA\u3002"
  - "\u4E24\u4EBA\u90FD\u62B5\u8FBE\u51FA\u53E3\uFF0C\u8BD5\u70BC\u624D\u7B97\u5B8C\u6210\u3002\u73B0\u5728\u2014\u2014"
  - "\u8BF7\u786E\u8BA4\u4F60\u4EEC\u8981\u6311\u6218\u7684\u4EFB\u52A1\u3002"
