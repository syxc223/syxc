  _npcName: "\u65F6\u7A7A\u4F7F\u8005"
  _missionId: 3
  _levelSceneName: Level3
  _levelTitle: "\u7B2C\u4E09\u5173\uFF1A\u53CC\u751F\u4ED3\u5E93"
  _levelDesc: "\u4E24\u6761\u4E00\u6A21\u4E00\u6837\u7684\u8D70\u5ECA\uFF0C\u53EA\u80FD\u9760\u5BF9\u65B9\u5F00\u95E8"
  _dialogueLines:
  - "\u6B22\u8FCE\u6765\u5230\u65F6\u7A7A\u8BD5\u70BC\u4E4B\u6BBF\u3002"
  - "\u4F60\u4EEC\u4E24\u4F4D\u5C06\u88AB\u9001\u5165\u540C\u4E00\u4E2A\u623F\u95F4\u2014\u2014\u8FD9\u662F\u4E00\u573A\u672A\u77E5\u7684\u8BD5\u70BC\uFF0C\u7B54\u6848\u90FD\u85CF\u5728\u7EC6\u8282\u91CC\u3002"
  - "\u300E\u7B54\u6848\uFF0C\u5F80\u5F80\u85CF\u5728\u4F60\u4EEC\u5FFD\u7565\u7684\u5730\u65B9\u3002\u300F"
  - "\u6162\u6162\u6765\uFF0C\u628A\u6BCF\u4E2A\u89D2\u843D\u90FD\u770B\u6E05\u695A\uFF1B\u4E24\u4E2A\u4EBA\u7684\u53D1\u73B0\u62FC\u5728\u4E00\u8D77\uFF0C\u624D\u662F\u5B8C\u6574\u7684\u7EBF\u7D22\u3002"
  - "\u4E24\u4EBA\u90FD\u62B5\u8FBE\u51FA\u53E3\uFF0C\u8BD5\u70BC\u624D\u7B97\u5B8C\u6210\u3002\u73B0\u5728\u2014\u2014"
  - "\u8BF7\u786E\u8BA4\u4F60\u4EEC\u8981\u6311\u6218\u7684\u4EFB\u52A1\u3002"
