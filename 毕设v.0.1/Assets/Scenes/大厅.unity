  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2039b04d3c3de3f4999d59b9d2e19e50, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _npcName: "\u65F6\u7A7A\u4F7F\u8005"
  _missionId: 1
  _levelSceneName: Level1
  _levelTitle: "\u7B2C\u4E00\u5173\uFF1A\u6D88\u5931\u7684\u94A5\u5319"
  _levelDesc: "\u5206\u5934\u8C03\u67E5\uFF0C\u628A\u4F60\u4EEC\u7684\u53D1\u73B0\u62FC\u8D77\u6765"
  _dialogueLines:
  - "\u6B22\u8FCE\u6765\u5230\u65F6\u7A7A\u8BD5\u70BC\u4E4B\u6BBF\u3002"
  - "\u4F60\u4EEC\u4E24\u4F4D\u5C06\u88AB\u9001\u5165\u540C\u4E00\u4E2A\u623F\u95F4\u2014\u2014\u91CC\u9762\u53EA\u6709\u4E00\u6247\u5927\u95E8\uFF0C\u548C\u95E8\u65C1\u7684\u4E00\u884C\u5B57\u3002"
  - "\u300E\u53EA\u6709\u627E\u5230\u6B63\u786E\u7684\u94A5\u5319\u624D\u80FD\u79BB\u5F00\u3002\u300F"
  - "\u623F\u95F4\u91CC\u6709\u4E00\u5F20\u684C\u5B50\u3001\u4E00\u5E45\u58C1\u753B\u3001\u51E0\u4E2A\u7BB1\u5B50\u548C\u4E00\u53E3\u8001\u67DC\u5B50\u2026\u2026\u4E0D\u8FC7\uFF0C\u4F60\u4EEC\u4FE9\u7684\u773C\u775B\u4E0D\u4E00\u6837\uFF0C\u6709\u4E9B\u4E1C\u897F\u53EA\u6709\u4E00\u4E2A\u4EBA\u770B\u5F97\u61C2\u3002\u5206\u5934\u53BB\u7FFB\uFF0C\u7FFB\u5230\u4E86\u5C31\u544A\u8BC9\u5BF9\u65B9\u3002"
  - "\u627E\u4E0D\u5230\u7B54\u6848\u7684\u65F6\u5019\uFF0C\u5C31\u518D\u8BFB\u4E00\u904D\u95E8\u65C1\u90A3\u884C\u5B57\u2014\u2014\u4E00\u4E2A\u5B57\u90FD\u4E0D\u8981\u653E\u8FC7\u3002\u770B\u7834\u4E86\uFF0C\u95E8\u81EA\u7136\u5C31\u5F00\u4E86\u3002"
  - "\u51FA\u53E3\u524D\u8FD8\u6709\u4E00\u9053\u95F8\u95E8\u2014\u2014\u8E0F\u677F\u4E00\u4E2A\u4EBA\u8E29\u4E0D\u4F4F\u4E24\u5757\uFF0C\u8F6E\u6D41\u4E3A\u5BF9\u65B9\u5F00\u8DEF\u3002\u4E24\u4EBA\u90FD\u62B5\u8FBE\u51FA\u53E3\uFF0C\u8BD5\u70BC\u624D\u7B97\u5B8C\u6210\u3002\u73B0\u5728\u2014\u2014"
  - "\u8BF7\u9009\u62E9\u4F60\u4EEC\u8981\u6311\u6218\u7684\u4EFB\u52A1\u3002"
  _dialoguePanel: {fileID: 1957620115}
